{
	admin off
	auto_https off
}

# TLS ends at Coolify's proxy; this only serves the static build
:80 {
	root * /srv
	encode zstd gzip

	# Hashed file names, safe to cache forever
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# Prerendered pages live in <path>/index.html; anything else (panel, /editor/$key)
	# gets the SPA shell, which routes on the client
	try_files {path} {path}/index.html /_shell.html
	file_server
}
