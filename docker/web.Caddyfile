{
	admin off
	auto_https off
}

# TLS ends at Coolify's proxy; this only serves the static build
:80 {
	root * /srv
	encode zstd gzip

	# The bot's Discord invite; INVITE_LINK is the same env var core uses (a Discord
	# authorize URL, so it already has a query). ?guild=<id> (the panel's sidebar) picks
	# that server in Discord's dialog. Only digits pass, so the param can't smuggle other
	# authorize params (permissions, scope) into the link.
	@invite path /invite /invite/
	@inviteGuild expression `{query.guild}.matches("^[0-9]+$")`
	route @invite {
		redir @inviteGuild {$INVITE_LINK}&guild_id={query.guild}&disable_guild_select=true 302
		redir {$INVITE_LINK} 302
	}

	# The brand pages became chapters of the brand book under /branding
	@oldLogo path /logo /logo/
	redir @oldLogo /branding/logo 301
	@oldStaticLogo path /static-logo /static-logo/
	redir @oldStaticLogo /branding/static-logo 301
	@oldFeedback path /feedback /feedback/
	redir @oldFeedback /branding/feedback 301

	# Hashed file names, safe to cache forever
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# Client-only routes (panel, /editor/$key) get the SPA shell, which routes on the client
	@client path /panel /panel/* /editor/*
	handle @client {
		try_files {path} {path}/index.html /_shell.html
		file_server
	}

	# Everything else: a file or a prerendered <path>/index.html, otherwise a real 404
	handle {
		try_files {path} {path}/index.html
		file_server
	}

	# file_server keeps the error's status, so this answers 404 with the prerendered page
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
