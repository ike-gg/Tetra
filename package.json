{
  "name": "tetra",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n core,web -c blue,yellow \"bun dev:core\" \"bun dev:web\"",
    "dev:core": "bun --filter @tetra/core dev",
    "dev:web": "bun --filter @tetra/web dev",
    "build:web": "bun --filter @tetra/web build",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:push": "bun --filter @tetra/core db:push",
    "db:studio": "bun --filter @tetra/core db:studio",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "bun --filter '@tetra/*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "concurrently": "10.0.7"
  }
}
