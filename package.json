{
  "name": "tetra",
  "version": "2.0.0",
  "description": "Emote management Discord bot.",
  "main": "src/index.ts",
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "deploy:dev": "bun run src/deploy/deploy-commands-dev.ts",
    "deployCommands": "bun run src/deploy/deploy-commands-global.ts",
    "db:push": "npx drizzle-kit push",
    "db:studio": "npx drizzle-kit studio",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "tsc --noEmit"
  },
  "author": "ike",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "^1.2.2",
    "@types/cheerio": "^0.22.31",
    "@types/cookie-parser": "^1.4.3",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.13",
    "@types/crypto-js": "^4.1.1",
    "@types/emoji-flags": "^1.3.3",
    "@types/express": "^5.0.0",
    "@types/gifsicle": "^5.2.2",
    "@types/is-base64": "^1.1.3",
    "@types/is-gif": "^4.0.3",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.27",
    "@types/needle": "^3.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.11",
    "@types/sharp": "^0.31.0",
    "@types/tmp": "^0.2.3",
    "drizzle-kit": "^0.30.2",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@discordjs/core": "^2.7.0",
    "@twurple/api": "^7.0.6",
    "@twurple/auth": "^7.0.6",
    "chalk": "^4.1.2",
    "console-table-printer": "^2.12.1",
    "cookie-session": "^2.1.0",
    "cors": "^2.8.5",
    "discord-oauth2": "^2.12.1",
    "discord.js": "14.28.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "express": "^5.0.1",
    "express-rate-limit": "^6.7.0",
    "gifsicle": "^7.0.1",
    "ioredis": "^5.8.0",
    "is-gif": "^4.0.1",
    "lodash": "^4.17.21",
    "nanoid": "^5.1.6",
    "pg": "^8.13.1",
    "pretty-bytes": "^5.6.0",
    "sharp": "^0.31.1",
    "videoshow": "^0.1.12",
    "zod": "^3.21.4"
